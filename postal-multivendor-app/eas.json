{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "http://localhost:4000"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "staging": {
      "developmentClient": false,
      "channel": "staging",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://postal-multivendor-production.up.railway.app/",
        "EXPO_PUBLIC_GRAPHQL_URL": "https://postal-multivendor-production.up.railway.app/graphql",
        "EXPO_PUBLIC_WS_GRAPHQL_URL": "wss://postal-multivendor-production.up.railway.app/graphql"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://postal-multivendor-production.up.railway.app/",
        "EXPO_PUBLIC_GRAPHQL_URL": "https://postal-multivendor-production.up.railway.app/graphql",
        "EXPO_PUBLIC_WS_GRAPHQL_URL": "wss://postal-multivendor-production.up.railway.app/graphql"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "production"
      },
      "ios": {
        "appleId": "sharan.gohar@icloud.com",
        "ascAppId": "1526488093",
        "appleTeamId": "GDFK7MVY6P"
      }
    }
  },
  "cli": {
    "version": ">= 0.43.0"
  }
}