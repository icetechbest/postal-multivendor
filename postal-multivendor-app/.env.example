EXPO_PUBLIC_GRAPHQL_URL=https://postal-multivendor-production.up.railway.app/graphql

EXPO_PUBLIC_WS_GRAPHQL_URL=wss://postal-multivendor-production.up.railway.app/graphql

EXPO_PUBLIC_SERVER_URL=https://postal-multivendor-production.up.railway.app/

# OpenStreetMap map services (no API key / no billing required)
# Optional: the database Configuration values take priority, then these env
# vars, then the public defaults shown below.
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_GEOCODING_URL=https://nominatim.openstreetmap.org
EXPO_PUBLIC_ROUTING_URL=https://router.project-osrm.org
