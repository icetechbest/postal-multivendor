# Public base URL of the existing GraphQL backend (no secrets here).
NEXT_PUBLIC_SERVER_URL="http://localhost:8001/"
NEXT_PUBLIC_WS_SERVER_URL="ws://localhost:8001/"

# Waiting-time thresholds (minutes) for the live timer colours.
NEXT_PUBLIC_WARN_MINUTES="5"
NEXT_PUBLIC_DANGER_MINUTES="10"

# Polling fallback interval (ms) when the websocket is down.
NEXT_PUBLIC_POLL_INTERVAL_MS="15000"
