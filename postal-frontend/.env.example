NEXT_PUBLIC_SERVER_URL="http://localhost:8001/"
NEXT_PUBLIC_WS_SERVER_URL="ws://localhost:8001/"

# OpenStreetMap map services (no API key / no billing required)
# Optional fallbacks: values saved from the admin Configuration screen take
# priority, then these env vars, then the public defaults below.
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_GEOCODING_URL="https://nominatim.openstreetmap.org"
NEXT_PUBLIC_ROUTING_URL="https://router.project-osrm.org"
