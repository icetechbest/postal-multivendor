# ── Postal Admin App (Expo) ───────────────────────────────────────────────
# Copy to `.env` and adjust. Expo only exposes variables prefixed EXPO_PUBLIC_.
# Never commit real secrets or production URLs.

# REST/GraphQL backend base URL (no trailing slash, no /graphql suffix)
EXPO_PUBLIC_SERVER_URL=http://localhost:8001

# WebSocket base URL for GraphQL subscriptions (ws:// or wss://)
EXPO_PUBLIC_WS_SERVER_URL=ws://localhost:8001

# Main admin website opened from the "Open on web" button
EXPO_PUBLIC_WEB_ADMIN_URL=http://localhost:3000
