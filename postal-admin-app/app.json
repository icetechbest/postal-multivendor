{
  "expo": {
    "name": "Postal Admin",
    "slug": "postal-admin-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "postaladmin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#0f766e",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.postal.admin",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock the Postal admin app with Face ID."
      }
    },
    "android": {
      "package": "com.postal.admin",
      "adaptiveIcon": {
        "backgroundColor": "#0f766e"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0f766e"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock the Postal admin app with Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1b6608a8-dd47-4071-99f1-fde814567d13"
      }
    }
  }
}
