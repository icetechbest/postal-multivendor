EXPO_PUBLIC_GRAPHQL_URL=http://localhost:8001/graphql
EXPO_PUBLIC_WS_GRAPHQL_URL=ws://localhost:8001/graphql

# OpenStreetMap map services (no API key / no billing required)
# Optional: database Configuration values take priority, then these env vars,
# then the public defaults shown below.
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_GEOCODING_URL=https://nominatim.openstreetmap.org
EXPO_PUBLIC_ROUTING_URL=https://router.project-osrm.org
